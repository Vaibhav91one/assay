# Copy to .env and fill in. Never commit .env -- it is gitignored.
#
# Every name here is a name the code actually reads, and every name the code
# reads is here. `test/env-names.test.ts` fails on either kind of drift -- a
# variable declared here that nothing reads sends an operator to set something
# that does nothing, and a variable the code reads that is not declared here is
# a setting nobody can find.

# --- store -------------------------------------------------------------------
DATABASE_URL=postgres://assay:assay@localhost:5432/assay
ASSAY_CAPTURES=captures

# --- scraping ----------------------------------------------------------------
# Your own Bright Data token. Assay never ships one. This is the name
# `tools/bd-heal.ts` and `tools/bd-status.sh` read, and the name the heal run in
# `results/` was made with.
#
# It buys ONE of Bright Data's two directions: it lets Assay CALL Bright Data.
# The other direction -- Bright Data POSTing a scraped page to Assay -- is the
# delivery webhook, which is a secret in `data/connectors.json` and has nothing
# to do with this variable. `assay connectors set brightdata` mints that one.
# Settings shows both, separately, because setting this does not configure that.
BRIGHTDATA_API_TOKEN=
# Your own Firecrawl key, read by `src/skills/page.ts`. This is the connector
# that fetches a page refusing a plain request. Optional, and optional in a
# stronger sense than the rest: it is tried only AFTER a direct fetch is
# refused, so an instance without it loses nothing on pages that already work.
# Two things have to be true before a request goes out, on purpose -- the key
# here, AND the id in the skills file below. A key in a shell is not consent to
# send someone's traffic to a third party:
#   echo '{"enabled":["firecrawl"]}' > data/skills.json
FIRECRAWL_API_KEY=
# Where `tools/selfheal.ts` looks for the live testbed, and the only reason it
# is a variable at all: pointing it at a host that is not there is how the
# "testbed unreachable" path gets exercised without waiting for a real outage.
# Unset means the public testbed, which needs no credential of any kind.
ASSAY_TESTBED=

# --- model -------------------------------------------------------------------
# Optional. Assay runs with no model -- a model only ever proposes and the gate
# decides, so leaving this blank costs field discovery and second-opinion
# checks and nothing else. src/ai/model.ts reads it; presence only, never echoed.
ANTHROPIC_API_KEY=
# Or, on your own machine with a Claude subscription: `claude setup-token`.
# Either one satisfies the model path. A deployment other people use takes the key.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional model ids. Blank means the default in src/ai/model.ts and
# src/agent/index.ts. ASSAY_MODEL is the healer's; ASSAY_CHAT_MODEL is the
# in-app agent's.
ASSAY_MODEL=
ASSAY_CHAT_MODEL=

# --- auth --------------------------------------------------------------------
# none  = single-operator self-host, no accounts, no sign-in (default). Assay
#         authenticates nobody in this mode and assumes a network boundary
#         around the box -- put it behind your own access control.
# clerk = hosted instance; requires the Clerk keys below
AUTH_MODE=none
# Read by @clerk/nextjs itself, not by Assay -- so these are Clerk's own names.
# The publishable key must carry the NEXT_PUBLIC_ prefix or the browser SDK
# never sees it. Without the sign-in URL, `auth.protect()` redirects to Clerk's
# hosted Account Portal instead of Assay's own sign-in screen.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# --- local dev behind a reverse-proxy tunnel (ngrok, etc.) -------------------
# next dev only -- irrelevant to next start, which is what a real self-host
# deployment runs. Needed only when driving a real OAuth client (claude's
# connector picker, chiefly) through a tunnel: without it, next dev refuses
# the /oauth/authorize Server Action with "Invalid Server Actions request".
ASSAY_DEV_ORIGIN=

# --- delivery ----------------------------------------------------------------
# Your own Resend key and your own verified sending domain. Optional: with no
# key the worker records the break as undelivered and carries on.
ASSAY_RESEND_KEY=
ASSAY_MAIL_FROM=
ASSAY_MAIL_TO=
# Resend's Svix signing secret for the bounce webhook receiver
# (whsec_... from the Resend dashboard). Optional: with it unset, a real
# bounce/complaint event is recorded as undelivered instead of falling back
# to the outbound webhook below.
RESEND_WEBHOOK_SECRET=
# Or alert to something other than email. The secret signs the payload.
ASSAY_WEBHOOK_URL=
ASSAY_WEBHOOK_SECRET=

# --- connectors and page sources ---------------------------------------------
# Where the connector config lives (default `data/connectors.json`), and the
# comma-separated hosts a connector may reach.
ASSAY_CONNECTORS=
ASSAY_CONNECTOR_HOSTS=
# Which page sources the operator has consented to (default `data/skills.json`).
# `{"enabled":["firecrawl"]}` is the whole file. Read by `src/skills/store.ts`;
# nothing in Assay writes it.
ASSAY_SKILLS=

# `1` shows all six composer modes. Four are prefix-only with nothing behind
# them, so only Watch and Research are offered. Read by web/lib/composer-menu.ts.
NEXT_PUBLIC_ASSAY_ALL_MODES=
