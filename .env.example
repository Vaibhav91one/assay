# Copy to .env and fill in. Never commit .env -- it is gitignored.
#
# Every name here is a name the code actually reads, and every name the code
# reads is here. `test/env-names.test.ts` fails on either kind of drift -- a
# variable declared here that nothing reads sends an operator to set something
# that does nothing, and a variable the code reads that is not declared here is
# a setting nobody can find.

# --- store -------------------------------------------------------------------
DATABASE_URL=postgres://assay:assay@localhost:5432/assay
ASSAY_CAPTURES=captures

# --- scraping ----------------------------------------------------------------
# Your own Bright Data token. Assay never ships one. This is the name
# `tools/bd-heal.ts` and `tools/bd-status.sh` read, and the name the heal run in
# `results/` was made with.
BRIGHTDATA_API_TOKEN=
# Your own Firecrawl key, read by `src/skills/page.ts`. Optional, and optional in
# a stronger sense than the rest: the connector is tried only AFTER a direct
# fetch is refused, so an instance without it loses nothing on pages that already
# work. It also has to be enabled on /skills before a single request goes out.
FIRECRAWL_API_KEY=

# --- model -------------------------------------------------------------------
# Optional. Assay runs with no model -- a model only ever proposes and the gate
# decides, so leaving this blank costs field discovery and second-opinion
# checks and nothing else. src/ai/model.ts reads it; presence only, never echoed.
ANTHROPIC_API_KEY=
# Or, on your own machine with a Claude subscription: `claude setup-token`.
# Either one satisfies the model path. A deployment other people use takes the key.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional model ids. Blank means the default in src/ai/model.ts and
# src/agent/index.ts. ASSAY_MODEL is the healer's; ASSAY_CHAT_MODEL is the
# in-app agent's.
ASSAY_MODEL=
ASSAY_CHAT_MODEL=

# --- auth --------------------------------------------------------------------
# none  = single-operator self-host, no accounts, no sign-in (default). Assay
#         authenticates nobody in this mode and assumes a network boundary
#         around the box -- put it behind your own access control.
# clerk = hosted instance; requires the Clerk keys below
AUTH_MODE=none
# Read by @clerk/nextjs itself, not by Assay -- so these are Clerk's own names.
# The publishable key must carry the NEXT_PUBLIC_ prefix or the browser SDK
# never sees it. Without the sign-in URL, `auth.protect()` redirects to Clerk's
# hosted Account Portal instead of Assay's own sign-in screen.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# --- delivery ----------------------------------------------------------------
# Your own Resend key and your own verified sending domain. Optional: with no
# key the worker records the break as undelivered and carries on.
ASSAY_RESEND_KEY=
ASSAY_MAIL_FROM=
ASSAY_MAIL_TO=
# Or alert to something other than email. The secret signs the payload.
ASSAY_WEBHOOK_URL=
ASSAY_WEBHOOK_SECRET=

# --- connectors and skills -----------------------------------------------------
# Where the connector config lives (default `data/connectors.json`), and the
# comma-separated hosts a connector may reach.
ASSAY_CONNECTORS=
ASSAY_CONNECTOR_HOSTS=
# Which skills are enabled (default `data/skills.json`).
ASSAY_SKILLS=
