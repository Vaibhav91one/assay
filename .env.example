# Copy to .env and fill in. Never commit .env -- it is gitignored.

# --- store -------------------------------------------------------------------
DATABASE_URL=postgres://assay:assay@localhost:5432/assay
ASSAY_CAPTURES=captures

# --- scraping ----------------------------------------------------------------
# Your own Bright Data token. Assay never ships one.
BRIGHT_DATA_TOKEN=

# --- model -------------------------------------------------------------------
# Optional. Assay runs with no model -- a model only ever proposes and the gate
# decides, so leaving this blank costs field discovery and second-opinion
# checks and nothing else. src/ai/model.ts reads it; presence only, never echoed.
ANTHROPIC_API_KEY=
# Or, on your own machine with a Claude subscription: `claude setup-token`.
# Either one satisfies the model path. A deployment other people use takes the key.
CLAUDE_CODE_OAUTH_TOKEN=

# --- auth --------------------------------------------------------------------
# none  = single-operator self-host, no accounts, no sign-in (default)
# clerk = hosted instance; requires the Clerk keys below
AUTH_MODE=none
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- delivery ----------------------------------------------------------------
# Your own Resend key and your own verified sending domain.
RESEND_API_KEY=
ASSAY_MAIL_FROM=
